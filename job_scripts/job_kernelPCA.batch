#!/bin/bash

#SBATCH --nodes=1
#SBATCH --partition=amilan
#SBATCH --ntasks=64
#SBATCH --mem=200G
#SBATCH --job-name="kernelPCA"  # used as folder name for output
#SBATCH -o "/scratch/alpine/sridoux@xsede.org/ms-proj/gene_summaries/out/kPCA-log_%A_%a.out"
#SBATCH -e "/scratch/alpine/sridoux@xsede.org/ms-proj/gene_summaries/err/kPCA-log_%A_%a.err"
#SBATCH --account=amc-general
#SBATCH --time=23:59:00
#SBATCH --array=1-21


chunk_size=1000  # size of each chunk in number genes
chunk_num=$SLURM_ARRAY_TASK_ID  # number of current chunk launching analysis for

module load miniforge
mamba activate ms-proj

Rscript /scratch/alpine/sridoux@xsede.org/ms-proj/kernelPCA-HPC.R \
        "$chunk_size" "$chunk_num"


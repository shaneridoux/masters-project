\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces {\bf  Shannon's $3^{\text  {rd}}$ Property of $H$}   This is a decomposition of a choice from three possibilities. The {\bf  left tree} has \textit  {one choice} with probabilities $p_{l1}=\frac  {1}{2}, p_{l2}=\frac  {1}{3}, p_{l3}=\frac  {1}{6}$ and the {\bf  right tree} has \textit  {two choices} with the first having equal probability $p_{r1}=p_{r2}=\frac  {1}{2}$ and the second having probabilities $p_{r21}=\frac  {2}{3},p_{r22}=\frac  {1}{3}$\cite  {shannonMathematicalTheoryCommunication}.}}{10}{figure.caption.11}\protected@file@percent }
\newlabel{fig:entropy}{{5}{10}{{\bf Shannon's $3^{\text {rd}}$ Property of $H$} \\ This is a decomposition of a choice from three possibilities. The {\bf left tree} has \textit {one choice} with probabilities $p_{l1}=\frac {1}{2}, p_{l2}=\frac {1}{3}, p_{l3}=\frac {1}{6}$ and the {\bf right tree} has \textit {two choices} with the first having equal probability $p_{r1}=p_{r2}=\frac {1}{2}$ and the second having probabilities $p_{r21}=\frac {2}{3},p_{r22}=\frac {1}{3}$\cite {shannonMathematicalTheoryCommunication}}{figure.caption.11}{}}
\newlabel{eq:entropy}{{1}{10}{Entropy}{equation.1}{}}
\citation{shannonMathematicalTheoryCommunication}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces {\bf  Entropy as Expected Uncertainty}   Entropy $H(p)$, or the expected uncertainty of a binary outcome, is plotted as a function of the event probability $p$. The curve is maximized at $p = 0.5$, where uncertainty is highest. As $p\to 0$ or $p \to 1$, the outcome becomes more predictable and the entropy approaches 0\cite  {shannonMathematicalTheoryCommunication,saraivaShannonEntropyIts2023}.}}{11}{figure.caption.12}\protected@file@percent }
\newlabel{fig:entropy_graph}{{6}{11}{{\bf Entropy as Expected Uncertainty} \\ Entropy $H(p)$, or the expected uncertainty of a binary outcome, is plotted as a function of the event probability $p$. The curve is maximized at $p = 0.5$, where uncertainty is highest. As $p\to 0$ or $p \to 1$, the outcome becomes more predictable and the entropy approaches 0\cite {shannonMathematicalTheoryCommunication,saraivaShannonEntropyIts2023}}{figure.caption.12}{}}
\newlabel{eq:joint_entropy}{{2}{11}{Entropy}{equation.2}{}}

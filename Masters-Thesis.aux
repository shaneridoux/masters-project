\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces {\bf  Fitting with Natural Splines}   An illustration of natural spline smoothing applied to noisy, non-linear data. The gray points represent raw observations, while the blue curve shows the flexible fit obtained using natural spline basis functions. This demonstrates how splines can capture complex, multi-modal relationships without requiring a parametric form. As the degrees of freedom (df) in $ns(\cdot )$ increase, the fitted line becomes more flexible and approaches interpolation of the data, at the cost of smoothness.}}{18}{figure.caption.16}\protected@file@percent }
\newlabel{fig:splines}{{10}{18}{{\bf Fitting with Natural Splines} \\ An illustration of natural spline smoothing applied to noisy, non-linear data. The gray points represent raw observations, while the blue curve shows the flexible fit obtained using natural spline basis functions. This demonstrates how splines can capture complex, multi-modal relationships without requiring a parametric form. As the degrees of freedom (df) in $ns(\cdot )$ increase, the fitted line becomes more flexible and approaches interpolation of the data, at the cost of smoothness}{figure.caption.16}{}}
